{
  "name": "main",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "vite",
    "devf": "npm run dev -- --force",
    "build:prod": "npm run upgradeVersion && vite build && npm run zip",
    "build:stage": "npm run upgradeVersion && vite build --mode staging && npm run zip",
    "preview": "vite preview",
    "lint": "eslint --fix --ext .ts,.vue src",
    "api": "dots start",
    "api-git": "dots start --git",
    "zip": "node ./scripts/zip.js",
    "clean": "rimraf ./pnpm-lock.yaml && rimraf node_modules && pnpm i",
    "saveVersion": "node ./scripts/saveVersion.js",
    "upgradeVersion": "node ./scripts/upgradeVersion.js && npm run saveVersion",
    "release": "standard-version -- --first-release && npm run saveVersion",
    "upload": "node ./scripts/upload.js",
    "deploy": "npm run build:prod && npm run upload"
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.1",
    "@formkit/auto-animate": "^0.9.0",
    "@vueup/vue-quill": "1.2.0",
    "@vueuse/core": "14.0.0",
    "@zeronejs/utils": "^1.4.2",
    "axios": "1.6.8",
    "dayjs": "^1.11.13",
    "echarts": "5.5.1",
    "element-plus": "2.13.2",
    "file-saver": "2.0.5",
    "frappe-gantt": "^1.2.2",
    "frontendToolkit": "git+ssh://git@gitlab.maxrocky.com:chatBI/frontendToolkit.git",
    "fuse.js": "6.6.2",
    "js-cookie": "3.0.5",
    "jsencrypt": "3.3.2",
    "lodash": "^4.17.21",
    "marked": "^18.0.5",
    "md5": "^2.3.0",
    "mitt": "^3.0.1",
    "nprogress": "0.2.0",
    "pinia": "3.0.3",
    "qs": "^6.13.1",
    "vditor": "^3.11.2",
    "vue": "^3.5.17",
    "vue-cropper": "1.0.3",
    "vue-echarts": "^7.0.3",
    "vue-router": "4.3.2",
    "wujie-vue3": "^1.0.29"
  },
  "devDependencies": {
    "@iconify-json/ep": "^1.2.4",
    "@stylistic/eslint-plugin": "^1.8.1",
    "@types/file-saver": "^2.0.7",
    "@types/js-cookie": "^3.0.6",
    "@types/lodash": "^4.17.12",
    "@types/md5": "^2.3.5",
    "@types/node": "^18.19.66",
    "@types/nprogress": "^0.2.3",
    "@types/postcss-pxtorem": "^6.1.0",
    "@types/qs": "^6.9.17",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@unocss/preset-attributify": "^66.3.3",
    "@unocss/preset-icons": "^66.7.2",
    "@unocss/preset-uno": "^66.3.3",
    "@vitejs/plugin-legacy": "^5.4.3",
    "@vitejs/plugin-vue": "5.0.4",
    "@vue/eslint-config-airbnb": "^8.0.0",
    "autoprefixer": "^10.4.20",
    "code-inspector-plugin": "^1.2.10",
    "doc2ts": "^1.5.4",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.31.0",
    "form-data": "^4.0.4",
    "postcss": "^8.4.49",
    "postcss-pxtorem": "6.1.0",
    "sass": "^1.81.0",
    "standard-version": "^9.5.0",
    "terser": "^5.48.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2",
    "unocss": "^66.3.3",
    "unplugin-auto-import": "20.2.0",
    "unplugin-element-plus": "^0.8.0",
    "unplugin-vue-components": "^0.27.5",
    "vite": "5.2.11",
    "vite-plugin-cdn-import": "^1.0.1",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-dynamic-import-cdn": "^0.2.2",
    "vite-plugin-eslint": "^1.8.1",
    "vite-plugin-externals": "^0.6.2",
    "vite-plugin-svg-icons": "2.0.1",
    "vite-plugin-vue-setup-extend": "^0.4.0",
    "vue-eslint-parser": "^9.4.3",
    "zip-dir": "^2.0.0"
  }
}
